;;; -*- mode: lisp; base: 10; syntax: common-lisp; -*-
;;; system/core/runtime/supplement.dict
;;;
;;; SUPPLEMENTARY lexicon -- common words that are NOT in Marcus's verbatim
;;; dictionary (defs-dictionary.dict) but come up when parsing everyday
;;; example sentences. This file is OURS, not Marcus's: his
;;; defs-dictionary.dict stays pristine, and vocabulary he simply never
;;; entered is added here instead. Each form only ADDS a word; nothing
;;; here overrides a Marcus definition.
;;;
;;; Loaded by `load-supplement' (dictionary.lisp) immediately AFTER the
;;; canonical dictionary, so the `jlike' targets below (block, boy, ...)
;;; already exist. It is read with the same MacLISP-flavored readtable as
;;; defs-dictionary.dict and the same definers from lexicon.lisp; the
;;; loader binds *package* to :parsifal, so (like the canonical file) this
;;; is data only -- no in-package form.
;;;
;;;   `jlike NEW OLD'  makes NEW share OLD's features, markers and case
;;;                    frame -- the cheapest faithful way to add a word.
;;;   Useful targets in Marcus's dict:
;;;     block  -- (noun ns n3p) markers (inanim physob)   [count thing]
;;;     boy    -- (noun ns n3p) markers (hanim physob)     [human]
;;;
;;; For a MASS noun, give it `massn' (plus `ns n3p') so a determiner-less NP
;;; like "red hair" is accepted -- NP-DONE labels a `massn, ns' nbar `massnp'
;;; (a valid NP), whereas a bare singular COUNT noun is labelled `bad'.
;;; Marcus's own dictionary happens to mark no nouns `massn', so there is no
;;; jlike target for a mass noun; define one with `df'.
;;;
;;; When you hit a missing word, prefer adding one line here over editing
;;; Marcus's source.

;; --- common nouns Marcus didn't enter ---
(df hair feats (noun massn ns n3p) markers (inanim physob)) ; MASS noun: "red hair"
(jlike tree block)      ; inanimate physobj count noun
(jlike telescope block) ; inanimate physobj count noun  (cf. "...with the telescope")
(jlike friend boy)      ; human animate noun
(jlike hamburger block) ; inanimate physobj count noun ("...for a hamburger")
(jlike pie block)       ; inanimate physobj count noun ("...ate the pie")
(jlike fruit block)     ; inanimate physobj count noun ("...ate the fruit")
(jlike cherry block)    ; inanimate physobj count noun ("...ate the cherry")

;; --- proper names ---
;; `name', not `propnoun': `name' is the feature the apposition rule and the
;; extractor look for ("the dog , fido" -> [DOG: Fido]). The marker types the
;; name when it stands ALONE -- anim -> ANIMAL, the way Marcus's `mitch'
;; (hanim) types as a person -- and is overridden by the head noun in an
;; apposition, which is the point of the construction.
(df fido feats (name ns n3p) markers (anim))
;; A PLACE, not a plain physobj: the `place' marker is what gets a locative PP
;; the `place' case, which cg-from-parse maps to (loc). Modelled on Marcus's
;; `chicago' minus the propnoun feature, since this one takes a determiner.
(df kitchen feats (noun ns n3p place) markers (place))

;; --- verbs Marcus didn't enter (2) ---
;; A plain transitive, modelled on his `see' minus the complement-taking
;; features (`ing-obj'/`to-less-inf-obj' are for "see him leaving"). NEUT is
;; narrowed from see's `all' to a physical inanimate: what gets eaten is a
;; thing, not a situation. The -s form needs no entry of its own -- `v-3s' on
;; the base is what lets "the dog eats" derive, the way "breaks" does.
;;
;; NB Marcus enters the past as (jlike ate broke), which copies broke's
;; features and leaves `ate' with no root, so it is NOT linked to this entry --
;; his own mechanism for that is `irreg', as in (df went irreg (go ...)).
;; Correcting it here would override a Marcus definition, which this file does
;; not do; cg-from-parse resolves ATE to EAT from cgraph's irregular-verb table
;; instead.
(df eat feats (mainverb pres tnsless v-3s)
     cf (neut agt)
     neut (# physob inanim #)
     markers act)

;; --- manner adverbs Marcus didn't enter ---
;; NB plain `df', not `df1': `df1' is Marcus's way of COMMENTING OUT a definition
;; (it expands to NIL), which is why his own `df1' adverbs ago/later/very are
;; inert. `manner' distinguishes these from temporal adverbs; the extractor reads
;; a manner adverb as [PRED]-(manr)->[MANNER]. Attached by the ADVERB-ADJUNCT
;; grammar rule (*adverb-rules*, our *grammar-extensions*).
(df quickly feats (adv manner))
(df slowly  feats (adv manner))
(df gladly  feats (adv manner))  ; attitudinal, but the one adverb bucket is `manner'

;; --- verbs Marcus didn't enter ---
;; `pay' is a give-class ditransitive transfer (recipient + optional amount),
;; modelled on Marcus's `give' (cf ((*obj dat) neut (dat) agt)). Extensions over
;; give, all optional, for "...pay you Tuesday for a hamburger today.":
;;   (time) -- a native TIME case (cf. `schedule'), so "Tuesday"/"today" have a
;;             slot to fill; (exch) -- the exchanged-for goods, which Marcus's
;;             `for' preposition already marks (cases-marked-by ... exch ...).
;; Present/base form only (used here as "will pay"); past "paid" is irregular and
;; left unentered until a sentence needs it.
(df pay feats (mainverb pres tnsless v-3s)
     cf ((*obj dat) (neut) (dat) (time) (exch) agt)
     neut (# money # physob abstr-ob)
     preps (for (exch))
     markers (act time))

;; `buy' and `sell' complete the commercial-transaction trio: pay/buy/sell are
;; three Fillmore PERSPECTIVES on one exchange, and the CG back-end
;; (cg-from-parse emit-exchange) promotes all three to the SAME [EXCHANGE]. Each
;; exposes the participants its perspective foregrounds, via these case slots:
;;   pay  (above): agt=buyer  dat=seller     exch=goods(for)  [money=neut/implicit]
;;   buy         : agt=buyer  source=seller(from)  neut=goods  exch=money(for)
;;   sell        : agt=seller dat=buyer      neut=goods       exch=money(for)
;; NB `buy' REPLACES Marcus's incidental `(jlike buy give)' -- a plain ditransitive
;; (agt/dat/neut) with no seller or price slot, so "buy a hamburger FROM you FOR
;; two dollars" dropped both PPs. This is the ONE place this file supersedes a
;; Marcus entry; `sell' he never entered. Present/base form only (irregular past
;; bought/sold left unentered until a sentence needs it).
(df buy feats (mainverb pres tnsless v-3s)
     cf ((neut) (source) (exch) (time) agt)
     neut (# hanim # anim inanim physob)
     preps (from (source) for (exch))
     markers (act))
(df sell feats (mainverb pres tnsless v-3s)
     cf ((*obj dat) neut (dat) (exch) (time) agt)
     neut (# hanim # anim inanim physob)
     preps (for (exch))
     markers (act))

;; currency noun for an exchanged amount ("...for two dollars"); `money' marker
;; (as in pay's neut) so it reads as the price, not the goods.
(df dollar feats (noun ns n3p) markers (money inanim physob))
