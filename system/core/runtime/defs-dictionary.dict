;;; -*- mode: lisp; base: 10; syntax: common-lisp -*-
;;; system/core/runtime/defs-dictionary.dict
;;;
;;; The data half of Marcus's defs.l (lines 31-876): the case-marker
;;; definitions and the verb / noun / adjective lexicon, via the
;;; (df ...) / (df1 ...) / (df+ ...) / (jlike ...) / (abbrev ...) family.
;;; This is DATA, not a compiled component: it is read and evaluated by
;;; `load-dictionary' (dictionary.lisp) with `*dictionary-readtable*'
;;; installed so that MacLISP's `#' marker-separator token reads as the
;;; symbol |#| and a bare `:' reads as |:|.  Hence the .dict extension --
;;; do NOT add it as a compilable :file.
;;;
;;; Lines 1-30 of defs.l (the feature ontology: setq of *nr-types* /
;;; *parts-of-speech* / ... and the `redund' declarations) are ported
;;; separately as defs.lisp. Everything from the first `df' (the case
;;; markersets at defs.l line 31) onward is data and lives here.
;;;
;;; Verbatim from defs.l 31-876 except for six terminal-noise forms
;;; dropped from the tail (lines 830, 832-836 of the source): captured
;;; `(PARSE)' parser-prompt echo and backspace/0x1E-corrupted tokens,
;;; which are session detritus, not lexicon entries.

(df agt markerset (# hanim # anim)) 
(df dat markerset (# hanim # anim)) 
;;Location should go to Allative, Trajectory, Ablative, Locative, Gen-locative
(df loc markerset (# place # inanim)) 
(df neut markerset (all))
(df pfrom markerset (# place # event socev inanim))
(df pto markerset (# place # event socev inanim))
(df pat markerset (# time # place)) ;;added by candy
(df puntil markerset (# time # place)) ;;added by candy
(df pdur markerset (# measure #))

(df time markerset (# time event #))

;;The whole distinction between Agent and Instrument is probably wrong.
(df ins markerset (# inanim #)) 
(df com markerset (# hanim # anim)) 
(df manner)
(df exch markerset (# money # physob anim inanim hanim))
(df benef markerset (# hanim # anim inanim physob))
(df source markerset (# hanim anim inanim physob #))
(df goal markerset (# hanim anim inanim physob #))
(df ess markerset (# hanim anim inanim physob #))
(df genloc markerset (# place # inanim))

;;NEWSTUFF
(df a\.m\. feats (postmod))
(jlike p\.m\. a\.m\.)
(jlike o\'clock a\.m\.)
(df oclock feats (postmod *o\'clock))


(df mr\. feats (noun ns title))
(jlike mrs\. mr\.)
(jlike miss mr\.)
(jlike ms\. mr\.)
(jlike prof\. mr\.)
(jlike dr\. mr\.)



(df schedule feats (verb pres tnsless  inf-obj v-3s ed=en)
     cf (neut (time) (loc) agt)
     neut (# socev inf-comp # event)
     markers (event time)
     preps ( for (time)))

(jlike re-schedule schedule)  ;;added by candy
(jlike re-locate schedule)  ;;added by candy
;;For the moment, unfortunately, meeting will be a noun while meet is a verb.
;;Lexical disambiguation will have to handle this when added.
(df meeting feats (noun ns) cf (com agt) markers (socev event mentob)) ;;changed by candy
(df+ |pa group meeting| jlike meeting)
(df+ |pa group meetings| jlike meetings)
(df+ |pa meeting| jlike meeting)
(df+ |pa meetings| jlike meetings)
(df time feats (noun ns n3p) markers (abstr-ob)) ;;added by candy
(jlike place time)   ;;added by candy
(df lecture feats (noun ns) markers (socev mentobj))
(jlike class lecture)


;;VERBS

(abbrev act (event action))
(df1 sit feats ( mainverb pres tnsless v-3s)
     cf (* (loc) agt)
     markers act)
                    
(df go feats ( mainverb pres tnsless v-3s)
     cf (nil (pfrom) (pto) agt)
     markers act)

(df gone irreg (go (en) (tnsless v-3s)))

(df went irreg (go (past vspl) (tnsless v-3s pres)))

(df come feats ( mainverb pres tnsless ed v-3s)
     cf ((pfrom) (pto) agt)
     markers act)
(df came irreg (come (past vspl) (tnsless v-3s pres)))

(jlike walk go)
(jlike run go)
(df1 leave feats ( mainverb pres tnsless v-3s)
     cf ((neut) (pto) (loc) actnt)
     markers act
     neut (all)
       preps (for (pto) at (loc) from (neut) to nil))
(df1 left irreg (leave (past vspl ed=en) (tnsless v-3s pres)))

(df deliver feats ( mainverb pres tnsless v-3s ed=en)
     cf ((neut) (pto) agt)
     markers act
     neut (# physob mentobj inanim #))

(jlike arrive come
       preps (at (pto) to nil))

(df analyze feats (mainverb pres tnsless v-3s ed=en)
     cf (neut (goal) agt)
     markers act
     neut (all))

(df attend feats ( mainverb pres v-3s tnsless ed=en)
     cf ((neut) agt)
     neut (#  socev # event)
     markers (action event))      

(df meet feats (mainverb pres v-3s tnsless)
     cf ((neut) (com) agt)
     neut (# hanim # anim)
     markers act)

(df met irreg (meet (past vspl en ed) (tnsless v-3s pres)))

(df1 fall feats ( mainverb pres tnsless v-3s) 
          cf (* (loc) neut)
     neut (# hanim anim inanim physob #)
     markers act)

(df1 fell irreg (fall (past vspl) (tnsless v-3s pres)))
     
(df break
     feats ( mainverb pres tnsless v-3s)
     cf (neut   (ins) (agt))
     neut (# physob inanim socev #)
     markers act)


(df1 kiss
     feats ( mainverb pres tnsless v-3s)
     cf ((neut) (loc)agt)
     neut (# hanim # anim inanim physob)
     markers act)

(df1 hit
     feats ( mainverb pres past vspl ed en tnsless)
     cf (neut  (loc) (ins) (agt))
     neut (# hanim anim inanim physob #)
     markers act)

(df1 hits irreg (hit (v3s) (tnsless past v-3s ed en)))

(df1 pick feats ( mainverb pres v-3s tnsless ed=en)
     cf ((neut) (source) agt)
     neut (# hanim anim inanim physob #)
     markers act)


(df1 pick-up feats ( mainverb pres tnsless v-3s tnsless ed=en)
     cf (neut  (ins) (agt))
     neut (# hanim anim inanim physob #)
     markers act)

(df give
     feats ( mainverb pres tnsless v-3s)
     cf ((*obj dat) neut  (dat) agt)
     neut (# hanim  # anim inanim physob)
     markers act)

(df change feats (verb pres tnsless  inf-obj v-3s ed=en)
     cf (neut (time) (loc) agt)
     neut (# socev inf-comp # event abstr-ob)
     markers (event time loc)
     preps (to (time loc)))   ;;added by candy

(df want feats (pres tnsless v-3s  subj-less-inf-obj ed=en)
     cf (neut  agt)
     neut (# physob inf-comp #)
     markers (state))

(df seem feats (pres tnsless v-3s that-obj to-be-less-inf-obj no-subj)
     cf (neut)
     neut ( # inf-comp that-comp # )
     markers (state))


(df believe feats ( pres tnsless v-3s  inf-obj that-obj ed=en)
     cf (neut  agt)
     neut (# hanim inf-comp that-comp #)
     markers (state))

(jlike know believe 
       feats (nil (ed=en)))

(df knew irreg (know (past vspl) (tnsless pres v-3s)))
(df known irreg (know (en) (tnsless pres v-3s)))

(df tell feats (pres tnsless v-3s obj-binds-delta comp-2-obj inf-obj that-obj)
     cf ((*obj dat) (neut) (dat) agt)
     neut (# inf-comp that-comp fact mentob # abstr-ob #)
     preps (about (neut))
     markers act) ;;changed by candy

(df told irreg (tell (past vspl en ed) (mainverb pres tnsless v-3s)))

(jlike persuade tell
       feats ((ed=en) nil)) ;;changed by candy (and partially corrected by mitch)

(jlike invite persuade
       neut (# inf-comp event socev #)
       preps (to (neut)))  ;;done by candy

(jlike say tell
       feats (nil (comp-2-obj))
       cases (nil (*obj))
       neut (# inf-comp that-comp #))

(df said irreg (say (past vspl en) (tnsless mainverb pres v-3s)))

(jlike promise persuade
       feats ((subj-binds-delta) (obj-binds-delta)))

(jlike ask persuade
       feats ((indirect-q-obj) (that-obj)))

(df see feats (tnsless v-3s mainverb pres ing-obj to-less-inf-obj)
     cf (neut  agt)
     neut (all)
     markers act)

(df saw irreg (see (past vspl) (tnsless mainverb pres v-3s)))       

(df shoot feats ( mainverb pres tnsless v-3s)
     cf (neut  (ins) agt)
     neut (# hanim inanim physob #)
     markers act)

(df shot irreg (shoot (past vspl ed en) (pres tnsless v-3s)))
(df gave irreg (give (past vspl) (tnsless pres v-3s)))
(df broke irreg (break (past vspl) (tnsless pres v-3s))) 



(df1 name feats ( tnsless ed=en)
     cf (ess  neut)
     neut (all)
     markers (state))

;;these definitions don't include case frames for now.
(df be feats (tnsless auxverb) cf (ess neut) neut (all) markers (state))
(df is irreg (be (pres v3s) (tnsless)))
(df am irreg (be (pres v1s) (tnsless)))
(df are irreg (be (pres vpl+2s) (tnsless)))
(df was irreg (be (past v13s) (tnsless)))
(df end feats (mainverb pres tnsless v-3s)
     cf (ess neut)
     neut (all)
     markers (state))    ;;added by candy

(df last feats (mainverb pres tnsless v-3s)
     cf (ess neut)
     neut (all)
     markers (state))   ;;added by candy
;;were doesn't include subjunctive usage yet
(df were irreg (be (past vpl+2s) (tnsless)))
(df will feats ( vspl auxverb future dummy))
;;did defined only as auxiliary here
(df do feats ( v-3s auxverb tnsless pres)
     cf (neut  (ins) agt)
     neut (# event thing #))
(df does irreg (do (v3s) (v-3s tnsless)))
(df did irreg (do (past vspl) (pres v-3s tnsless)))
(df done irreg (do (en) (pres v-3s tnsless)))
(df have feats (tnsless auxverb pres v-3s inf-obj to-less-inf-obj subj-less-inf-obj)
     cf (neut agt)
     markers (event)
     neut (all))
(df has irreg (have (v3s) (v-3s tnsless)))
(df had irreg (have (past vspl) (v-3s pres tnsless)))
(df can feats ( auxverb modal vspl pres))
(df could irreg (can (past) (pres)))


;;Quantifiers
(df which feats (*which) quant which)
(df all feats (quant npl) quant all)
(df some feats (quant npl ns) quant some)
(df any feats (quant ns npl) quant any)
(df several feats (quant npl) quant several)
(df1 none feats (quant ns) quant none)
(df1 each feats (quant ns) quant each)
(df many feats (quant npl detq) quant many)
(df few feats (quant npl detq) quant few)

;;Numbers
(abbrev twos (num ones npl n3p ))
(abbrev second (ord num ones npl n3p))
(abbrev tens (num tens ns n3p ))
(abbrev tenth (ord num tens n2 n3p))
(abbrev elevens (num 99s ns n3p ))
(abbrev eleventh (ord num 99s ns n3p))
(df one feats (num ones ns n3p ) quant 1)
(df first feats (ord num ones ns n3p) quant 1)
(df two feats twos quant 2)
(df second feats second quant 2)
(df three feats twos quant 3)
(df third feats second quant 3)
(df four feats twos quant 4)
(df fourth feats second quant 4)
(df five feats twos quant 5)
(df fifth feats second quant 5)
(df six feats twos quant 6)
(df sixth feats second quant 6)
(df seven feats twos quant 7)
(df seventh feats second quant 7)
(df eight feats twos quant 8.)
(df eighth feats second quant 8.)
(df nine feats twos quant 9.)
(df ninth feats second quant 9.)
(df ten feats tens quant 10.)
(df tenth feats tenth quant 10.)
(df eleven feats elevens quant 11.)
(df eleventh feats eleventh quant 11.)
(df twelve feats elevens quant 12.)
(df twelfth feats eleventh quant 12.)
(df thirteen feats elevens quant 13.)
(df thirteenth feats eleventh quant 13.)
(df fourteen feats elevens quant 14.)
(df fourteen feats eleventh quant 14.)
(df fifteen feats elevens quant 15.)
(df fifteenth feats eleventh quant 15.)
(df sixteen feats elevens quant 16.)
(df sixteenth feats eleventh quant 16.)
(df seventeen feats elevens quant 17.)
(df seventeenth feats eleventh quant 17.)
(df eighteen feats elevens quant 18.)
(df eighteenth feats eleventh quant 18.)
(df nineteen feats elevens quant 19.)
(df nineteenth feats eleventh quant 19.)
(df twenty feats tens quant 20.)
(df twentieth feats tenth quant 20.)
(df thirty feats tens quant 30.)
(df thirtieth feats tenth quant 30.)
(df forty feats tens quant 40.)
(df fortieth feats tenth quant 40.)
(df fifty feats tens quant 50.)
(df fiftieth feats tenth quant 50.)
(df sixty feats tens quant 60.)
(df sixtieth feats tenth quant 60.)
(df seventy feats tens quant 70.)
(df seventieth feats tenth quant 70.)
(df eighty feats tens quant 80.)
(df eightieth feats tenth quant 80.)
(df ninety feats tens quant 90.)
(df ninetieth feats tenth quant 90.)
(df hundred feats (num npl ) quant 100.)
(df hundredth feats (ord num npl) quant 100.)


;;Pronouns

(df who feats (pronoun relpron ns npl wh) markers (hanim))
(df wh\- feats (pronoun relpron ns npl wh) markers (hanim physob))
;;need to handle ambiguity here
(df what feats (ngstart det\\relpron-ambig))
;;whether that is used as a det or comp is decided
;;by a grammar rule
(df that feats (det\\comp-ambig) markers (physob))
(df1 when feats (pronoun relpron ns wh time))
(df1 where feats (pronoun relpron ns wh place))

(df1 everyone feats (pronoun ns n3p) markers (hanim physob))

(df i feats (pronoun ns n1p) markers (hanim physob))
(df me irreg (i nil nil))
(df my irreg (i (poss-pronoun) nil))
(df we feats (pronoun npl n1p) markers (hanim physob))
(df us irreg (we nil nil))
(df our irreg (we (poss-pronoun) nil))
(df you feats (pronoun ns npl n2p) markers (hanim))
(df your irreg (you (poss-pronoun) nil))
(df he feats (pronoun ns n3p) markers (hanim physob))
(df him irreg (he nil nil))
(df his irreg (he (poss-pronoun) nil))
(df she feats (pronoun ns n3p) markers (hanim physob))
(df her irreg (she nil nil))
(df hers irreg (she (poss-pronoun) nil))
(df it feats (pronoun ns n3p) markers (inanim physob event mentob))
(df its irreg (it (poss-pronoun) nil))
(df they feats (pronoun npl n3p) markers (hanim physob))
(df them irreg (they nil nil))
(df their irreg (they (poss-pronoun) nil))


;;Nouns
(df1 lunch feats (noun ns n3p time cantmod) markers (socev time))
(jlike dinner lunch)
(jlike breakfast lunch)
(df destruction feats (noun ns)
     markers (event)  
     cf ((neut) (ins) (agt))
     neut (# physob inanim place #))

(df1 shipment feats (noun n3p ns)
     markers (event physob)
     cf ((neut) (pfrom) (pto) (agt))
     neut (# physob inanim #))
     
(df chicago feats (noun ns n3p propnoun place) markers (place))
(jlike u\.s\. chicago)
(df mitch feats (noun ns n3p propnoun name) markers (hanim))
(df1 home feats (noun ns n3p place) markers (place))

(df there feats (noun pseudopropnoun place ns n3p) markers (place))
(df store feats (noun ns n3p) markers (physob place))
(jlike office store)
(df monday feats (noun ns n3p day-of-week time) markers (time))
(jlike tuesday monday)
(jlike wednesday monday)
(jlike thursday monday)
(jlike friday monday)
(jlike saturday monday)
(jlike sunday monday)

(df january feats (noun ns n3p time month) markers (time))
(jlike jan\. january)
(jlike feb\. jan\.)
(jlike aug\. jan\.)
(jlike sept\. jan\.)
(jlike oct\. jan\.)
(jlike nov\. jan\.)
(jlike dec\. jan\.)
(jlike february jan\.)
(jlike march jan\.)
(jlike april jan\.)
(jlike june jan\.)
(jlike july jan\.)
(jlike august jan\.)
(jlike september jan\.)
(jlike october jan\.)
(jlike november jan\.)
(jlike december jan\.)
(comment may is ambigous!!!)

(df day feats (noun ns n3p time measure) markers (time))
(jlike month day)
(jlike week day)
(jlike year day)
(jlike yesterday wednesday) ;a hack to make PAL stuff easy for the moment - MM 4/78
(df1 yesterday feats (noun ns n3p time dow pseudopropnoun) markers (time))
(jlike tomorrow yesterday)
(jlike today yesterday)
(jlike tonight tomorrow) 
;;Sigh... why must tomorrow always be like yesterday?
(df1 date feats (noun ns n3p time) markers (time))

(df boy feats (noun ns n3p) markers (hanim physob))
(jlike girl boy)
(jlike man boy)
(jlike woman boy)
(df men irreg (man (npl) (ns)))
(df women irreg (woman (npl) (ns)))
(jlike child boy)
(df children irreg (child  (npl) (ns)))
(df elephant feats (noun ns n3p) markers (anim physob))
(df deer feats (noun ns npl n3p) markers (anim physob))
(jlike hippopo elephant)
(jlike dog elephant)
(jlike cat elephant)

(df block feats (noun ns n3p) markers (inanim physob))
(jlike cube block)
(jlike pyramid block)
(jlike rock block)
(jlike box block)
(jlike window block)
(jlike lollipop block)
(jlike table block)
(df1 present feats (noun ns n3p) markers (inanim physob))

(df pound feats (noun ns n3p measure) markers (measure))
(jlike ton pound)
(jlike inch pound)
(jlike foot inch)
(df1 feet irreg (foot (npl) (ns)))

(abbrev allphysobs  (# physob hanim anim inanim #))
;;Adjectives
(df next feats (ord general-ord))
(jlike last next)
(df last feats (ord general-ord))
(df red feats (adj)
     cf  (neut)
     markers (state)
     neut allphysobs)
(jlike blue red)
(jlike green red)
(df big  feats (adj)
     cf  (neut)
     markers (state)
     neut allphysobs)
(jlike little big)
(df wide feats (measure adj)
     cf  (neut)
     markers (state)
     neut allphysobs)
(jlike high wide)
(jlike tall wide)
(jlike short wide)
(df small feats (adj))
(df smart feats (adj)
     cf  (neut)
     markers (state)
     neut (# hanim # anim))
(jlike stupid smart)
(jlike careful smart)
(df bright feats (adj adv degree)
     cf  (neut)
     markers (state)
     neut (# physob anim inanim #))
(df1 eager feats (adj  inf-obj)
     cf ((neut) dat)
     markers (state)
     neut (# inf-comp #))


;;Determiners
(df the feats (det ns n3p npl def))
(df1 this feats (det ns n3p def))
(df a feats (det ns n3p indef))
(df an irreg (a nil nil))
(df1 every feats (det ns indef))
(df1 no feats (det ns indef))
(df \'s feats (poss))
;;Prepositions
(abbrev prepcf (ess neut))
(df with feats (prep) cases-marked-by (ins com)) 
(df to feats (prep auxverb ) cases-marked-by (dat time pto))
(df on feats (prep)					
     cf prepcf
     ess  (# time place physob #)
     neut (all)
     cases-marked-by (loc time))
(jlike in on)

(jlike at on) ;;To a first approximation
(df before feats (prep)
     cf prepcf
     ess (# time #)
     neut (all)
      cases-marked-by (time))
(df about feats (prep)
     cf prepcf
     ess (# time place physob #)
     neut (all)
     cases-marked-by (neut loc time)) ;;added by candy
(jlike after before)
(jlike during before)
(df1 up feats (prep) cases-marked-by (loc traj))
(jlike out up)
(jlike down up)
(df by feats (prep) cases-marked-by (agt loc time))
(df of feats (prep) cases-marked-by  nil)
(df for feats (prep) cases-marked-by (benef exch time goal pdur))
(df from feats (prep) cases-marked-by (source time pfrom))
(jlike until on) ;;done by candy
(jlike till until)
(jlike \'til until)

;;Punctuation
(df ? feats (finalpunc punc qpunc))
(df \. feats (finalpunc punc)) 
(df \, feats (apunc))


;;Adverbs
(df1 ago feats (adv time))
(df1 later feats (adv time))
(df1 very feats (adv degree))




;;Randomness- unfilled for now.
(df and feats (none-for-now))

