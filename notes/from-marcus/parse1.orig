(df fiftieth feats tenth quant 50.)
(df sixty feats tens quant 60.)
(df sixtieth feats tenth quant 60.)
(df seventy feats tens quant 70.)
(df seventieth feats tenth quant 70.)
(df eighty feats tens quant 80.)
(df eightieth feats tenth quant 80.)
(df ninety feats tens quant 90.)
(df ninetieth feats tenth quant 90.)
(df hundred feats (num npl ) quant 100.)
(df hundredth feats (ord num npl) quant 100.)


;;Pronouns

(df who feats (pronoun relpron ns npl wh) markers (hanim))
(df wh\- feats (pronoun relpron ns npl wh) markers (hanim physob))
;;need to handle ambiguity here
(df what feats (ngstart det\\relpron-ambig))
;;whether that is used as a det or comp is decided
;;by a grammar rule
(df that feats (det\\comp-ambig) markers (physob))
(df1 when feats (pronoun relpron ns wh time))
(df1 where feats (pronoun relpron ns wh place))

(df1 everyone feats (pronoun ns n3p) markers (hanim physob))

(df i feats (pronoun ns n1p) markers (hanim physob))
(df me irreg (i nil nil))
(df my irreg (i (poss-pronoun) nil))
(df we feats (pronoun npl n1p) markers (hanim physob))
(df us irreg (we nil nil))
(df our irreg (we (poss-pronoun) nil))
(df you feats (pronoun ns npl n2p) markers (hanim))
(df your irreg (you (poss-pronoun) nil))
(df he feats (pronoun ns n3p) markers (hanim physob))
(df him irreg (he nil nil))
(df his irreg (he (poss-pronoun) nil))
(df she feats (pronoun ns n3p) markers (hanim physob))
(df her irreg (she nil nil))
(df hers irreg (she (poss-pronoun) nil))
(df it feats (pronoun ns n3p) markers (inanim physob event mentob))
(df its irreg (it (poss-pronoun) nil))
(df they feats (pronoun npl n3p) markers (hanim physob))
(df them irreg (they nil nil))
(df their irreg (they (poss-pronoun) nil))


;;Nouns
(df1 lunch feats (noun ns n3p time cantmod) markers (socev time))
(jlike dinner lunch)
(jlike breakfast lunch)
(df destruction feats (noun ns)
     markers (event)  
     cf ((neut) (ins) (agt))
     neut (# physob inanim place #))

(df1 shipment feats (noun n3p ns)
     markers (event physob)
     cf ((neut) (pfrom) (pto) (agt))
     neut (# physob inanim #))
     
(df chicago feats (noun ns n3p propnoun place) markers (place))
(jlike u\.s\. chicago)
(df mitch feats (noun ns n3p propnoun name) markers (hanim))
(df1 home feats (noun ns n3p place) markers (place))

(df there feats (noun pseudopropnoun place ns n3p) markers (place))
(df store feats (noun ns n3p) markers (physob place))
(jlike office store)
(df monday feats (noun ns n3p day-of-week time) markers (time))
(jlike tuesday monday)
(jlike wednesday monday)
(jlike thursday monday)
(jlike friday monday)
(jlike saturday monday)
(jlike sunday monday)

(df january feats (noun ns n3p time month) markers (time))
(jlike jan\. january)
(jlike feb\. jan\.)
(jlike aug\. jan\.)
(jlike sept\. jan\.)
(jlike oct\. jan\.)
(jlike nov\. jan\.)
(jlike dec\. jan\.)
(jlike february jan\.)
(jlike march jan\.)
(jlike april jan\.)
(jlike june jan\.)
(jlike july jan\.)
(jlike august jan\.)
(jlike september jan\.)
(jlike october jan\.)
(jlike november jan\.)
(jlike december jan\.)
(comment may is ambigous!!!)

(df day feats (noun ns n3p time measure) markers (time))
(jlike month day)
(jlike week day)
(jlike year day)
(jlike yesterday wednesday) ;a hack to make PAL stuff easy for the moment - MM 4/78
(df1 yesterday feats (noun ns n3p time dow pseudopropnoun) markers (time))
(jlike tomorrow yesterday)
(jlike today yesterday)
(jlike tonight tomorrow) 
;;Sigh... why must tomorrow always be like yesterday?
(df1 date feats (noun ns n3p time) markers (time))

(df boy feats (noun ns n3p) markers (hanim physob))
(jlike girl boy)
(jlike man boy)
(jlike woman boy)
(df men irreg (man (npl) (ns)))
(df women irreg (woman (npl) (ns)))
(jlike child boy)
(df children irreg (child  (npl) (ns)))
(df elephant feats (noun ns n3p) markers (anim physob))
(df deer feats (noun ns npl n3p) markers (anim physob))
(jlike hippopo elephant)
(jlike dog elephant)
(jlike cat elephant)

(df block feats (noun ns n3p) markers (inanim physob))
(jlike cube block)
(jlike pyramid block)
(jlike rock block)
(jlike box block)
(jlike window block)
(jlike lollipop block)
(jlike table block)
(df1 present feats (noun ns n3p) markers (inanim physob))

(df pound feats (noun ns n3p measure) markers (measure))
(jlike ton pound)
(jlike inch pound)
(jlike foot inch)
(df1 feet irreg (foot (npl) (ns)))

(abbrev allphysobs  (# physob hanim anim inanim #))
;;Adjectives
(df next feats (ord general-ord))
(jlike last next)
(df last feats (ord general-ord))
(df red feats (adj)
     cf  (neut)
     markers (state)
     neut allphysobs)
(jlike blue red)
(jlike green red)
(df big  feats (adj)
     cf  (neut)
     markers (state)
     neut allphysobs)
(jlike little big)
(df wide feats (measure adj)
     cf  (neut)
     markers (state)
     neut allphysobs)
(jlike high wide)
(jlike tall wide)
(jlike short wide)
(df small feats (adj))
(df smart feats (adj)
     cf  (neut)
     markers (state)
     neut (# hanim # anim))
(jlike stupid smart)
(jlike careful smart)
(df bright feats (adj adv degree)
     cf  (neut)
     markers (state)
     neut (# physob anim inanim #))
(df1 eager feats (adj  inf-obj)
     cf ((neut) dat)
     markers (state)
     neut (# inf-comp #))


;;Determiners
(df the feats (det ns n3p npl def))
(df1 this feats (det ns n3p def))
(df a feats (det ns n3p indef))
(df an irreg (a nil nil))
(df1 every feats (det ns indef))
(df1 no feats (det ns indef))
(df \'s feats (poss))
;;Prepositions
(abbrev prepcf (ess neut))
(df with feats (prep) cases-marked-by (ins com)) 
(df to feats (prep auxverb ) cases-marked-by (dat time pto))
(df on feats (prep)					
     cf prepcf
     ess  (# time place physob #)
     neut (all)
     cases-marked-by (loc time))
(jlike in on)

(jlike at on) ;;To a first approximation
(df before feats (prep)
     cf prepcf
     ess (# time #)
     neut (all)
      cases-marked-by (time))
(df about feats (prep)
     cf prepcf
     ess (# time place physob #)
     neut (all)
     cases-marked-by (neut loc time)) ;;added by candy
(jlike after before)
(jlike during before)
(df1 up feats (prep) cases-marked-by (loc traj))
(jlike out up)
(jlike down up)
(df by feats (prep) cases-marked-by (agt loc time))
(df of feats (prep) cases-marked-by  nil)
(df for feats (prep) cases-marked-by (benef exch time goal pdur))
(df from feats (prep) cases-marked-by (source time pfrom))
(jlike until on) ;;done by candy
(jlike till until)
(jlike \'til until)

;;Punctuation
(df ? feats (finalpunc punc qpunc))
(df \. feats (finalpunc punc)) 
(df \, feats (apunc))


;;Adverbs
(df1 ago feats (adv time))
(df1 later feats (adv time))
(df1 very feats (adv degree))




;;Randomness- unfilled for now.
(df and feats (none-for-now))

